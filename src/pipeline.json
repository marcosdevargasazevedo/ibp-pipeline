          "name": "prepare_species.py",
          "path": "src/ibp/module4/prepare_species.py",
          "description": "Publish one validated, portable genome package per species and cohort."
        },
        {
          "name": "select_reference.py",
          "path": "src/ibp/module4/select_reference.py",
          "description": "Select the accepted chromosome with the lowest mean Mash distance per species."
        }
