        "\"src/ibp/module4/prepare_species.py\"",
        "RUN_ASSEMBLIES",
        "f\"{RUN_PROCESSED_DIR}/genome_qc.tsv\"",
        "SPECIES_TABLE",
        "lambda wildcards: REFERENCE_DIR.format(species=wildcards.species.rsplit(\"_\", 1)[-1]) + \"/reference.txt\""
