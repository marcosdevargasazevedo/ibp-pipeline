        "REFERENCE_DIR + \"/chromosomes.msh\"",
        "protected(directory(PREPARED_DIR))"
      ],
      "declaredInputs": [
        "\"src/ibp/module4/select_reference.py\"",
        "\"src/ibp/module3/normalize_chromosomes.py\"",
        "f\"{RUN_PROCESSED_DIR}/normalized_assemblies.tsv\"",
        "f\"{RUN_PROCESSED_DIR}/normalization.tsv\"",
        "reference_fastas",
        "reference_targets",
